{
  "manifest_version": 3,
  "name": "recall for Google Meet",
  "version": "0.1.0",
  "description": "Reports who is speaking in Google Meet to the local recall daemon.",
  "key": "",
  "host_permissions": ["http://127.0.0.1:7474/*"],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
