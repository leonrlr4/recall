[Unit]
Description=recall meeting recorder
After=pipewire.service

[Service]
ExecStart=%h/.cargo/bin/recall daemon
Restart=on-failure
RestartSec=2
TimeoutStopSec=10min
# SIGTERM goes to the daemon alone. It stops gpu-screen-recorder itself with
# SIGINT so the recorder finishes the screen file; a SIGTERM to the whole
# cgroup would end the recorder mid-write.
KillMode=mixed
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
